{
  "name": "r-markdown-cli",
  "version": "0.1.7",
  "type": "module",
  "bin": {
    "rmd": "dist/cli.js"
  },
  "files": [
    "dist",
    "skills",
    "README.md"
  ],
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build:dist": "node scripts/build-dist.js",
    "build:skills": "node scripts/build-skills.js",
    "test": "node --test",
    "conformance": "node spec/conformance/runner.js",
    "obsidian:build": "npm run build --workspace @rmd/obsidian-plugin",
    "obsidian:test": "npm run test --workspace @rmd/obsidian-plugin",
    "obsidian:typecheck": "npm run typecheck --workspace @rmd/obsidian-plugin",
    "rmd": "node packages/cli/src/index.js",
    "parse:example": "node examples/parse-example.js",
    "release": "node scripts/publish.js"
  },
  "dependencies": {
    "esbuild": "^0.28.0",
    "markdown-it": "^14.1.1"
  }
}
